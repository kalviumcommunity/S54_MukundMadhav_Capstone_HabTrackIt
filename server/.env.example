# ============================================================
# HabTrackIt legacy server — environment template (Railway)
# Copy to .env locally; set each variable on Railway for deploys.
# ============================================================

# --- Required: MongoDB Atlas ---
# Connection string for the Atlas cluster (include db name + credentials).
# Atlas side checklist: cluster resumed, database user exists with
# readWrite on the app database, Network Access allows Railway
# (0.0.0.0/0 if no static egress IP).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# --- Required: Auth (JWT) ---
# Must match the secret the issued tokens were signed with. Rotating this
# logs out every existing user (clients hold old-signed tokens).
JWT_SECRET=
# e.g. 7d  (jsonwebtoken expiresIn format)
JWT_EXPIRATION=7d

# Fallback password when signup arrives without one (legacy behavior).
DEFAULT_PASSWORD=

# --- Optional: Firebase Admin (server push via FCM) ---
# If ANY of these are missing/invalid, the server still boots — push is
# disabled with a warning instead of crashing (see index.js lazy init).
# Values come from the Firebase service-account JSON (Project Settings →
# Service accounts → Generate new private key).
TYPE=service_account
PROJECT_ID=
PRIVATE_KEY_ID=
PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
CLIENT_EMAIL=
CLIENT_ID=
AUTH_URI=https://accounts.google.com/o/oauth2/auth
TOKEN_URI=https://oauth2.googleapis.com/token
AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
CLIENT_X509_CERT_URL=
UNIVERSE_DOMAIN=googleapis.com

# --- Platform ---
# Railway injects PORT automatically; only set this for local runs.
PORT=3000
